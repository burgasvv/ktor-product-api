            <artifactId>ktor-server-content-negotiation</artifactId>
            <version>3.3.1</version>
            <scope>implementation</scope>
        </dependency>
        <dependency>
            <groupId>io.ktor</groupId>
            <artifactId>ktor-serialization-kotlinx-json</artifactId>
